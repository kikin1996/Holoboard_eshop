
# --- Přihlášení zákazníka (NextAuth / Prisma) ---
# Lokálně SQLite soubor, před nasazením přepnout na Postgres connection string
# (a v prisma/schema.prisma změnit datasource provider na "postgresql").
DATABASE_URL="file:./dev.db"
# Vygeneruj náhodný řetězec: `npx auth secret` nebo `openssl rand -base64 33`
AUTH_SECRET=replace-with-random-string

# --- Veřejné proměnné (smí jít do klienta, NEXT_PUBLIC_ prefix) ---
NEXT_PUBLIC_PACKETA_API_KEY=your-packeta-widget-api-key

# --- Backend / e-commerce jádro ---
MEDUSA_BACKEND_URL=https://your-medusa-instance.example.com
MEDUSA_ADMIN_TOKEN=replace-with-secret-admin-token
# Pokud používáte Strapi místo Medusy:
# STRAPI_URL=https://your-strapi-instance.example.com
# STRAPI_API_TOKEN=replace-with-secret-token

# --- Stripe (nikdy neprefixovat NEXT_PUBLIC_, zůstává jen na serveru) ---
# Bez STRIPE_SECRET_KEY běží checkout v demo režimu (bez reálné platby).
STRIPE_SECRET_KEY=sk_test_replace-with-your-secret-key
# Z Stripe Dashboard -> Developers -> Webhooks, po přidání endpointu /api/webhooks/stripe.
STRIPE_WEBHOOK_SECRET=whsec_replace-with-your-webhook-secret

# --- E-mailové notifikace o objednávce (Resend, resend.com) ---
# Bez API klíče se e-maily jen tiše přeskočí (viz lib/email.ts).
RESEND_API_KEY=re_replace-with-your-api-key
# Dokud nemáte ověřenou vlastní doménu v Resend, nechte na testovací adrese.
RESEND_FROM_EMAIL="HoloBoard <onboarding@resend.dev>"

# --- Revalidace obsahu (webhook z Medusy/Strapi po změně produktu) ---
REVALIDATE_SECRET=replace-with-random-string

# --- Veřejná URL nasazeného frontendu (pro redirect/cancel URL u Stripe) ---
NEXT_PUBLIC_SITE_URL=https://holoboard.vercel.app
